# Neon pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# PromptPay ID: mobile number (10 digits) or national ID (13 digits), digits only
PROMPTPAY_ID=
# Vercel Blob read/write token (created when connecting a Blob store to the Vercel project)
BLOB_READ_WRITE_TOKEN=
# Private shared secret used by the media upload screen; set a unique value in Vercel
BLOB_UPLOAD_SECRET=
