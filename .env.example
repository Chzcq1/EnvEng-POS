# Neon pooled connection string (Vercel production environment)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# PromptPay phone number or national ID, digits only (phone format: 0XXXXXXXXX)
PROMPTPAY_ID=0812345678
# Optional public URL to a static QR image; used only if PROMPTPAY_ID is empty
PROMPTPAY_QR_IMAGE_URL=
# Optional display idle media (publicly accessible URLs)
NEXT_PUBLIC_IDLE_MEDIA_URL=
NEXT_PUBLIC_IDLE_VIDEO_URL=
NEXT_PUBLIC_ECO_ITEM_LABEL=ชิ้นส่วนหน่อกล้วย
NEXT_PUBLIC_PAID_RESET_SECONDS=7
